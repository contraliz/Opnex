{
  "name": "pseudoharness",
  "version": "1.1.2",
  "description": "Local Codex delegation harness with app-server and AgentMem integrations",
  "main": "dist-server/index.js",
  "bin": {
    "pseudoharness": "bin/pseudoharness.js"
  },
  "files": [
    "LICENSE",
    "README.md",
    "bin/",
    "dist/",
    "dist-server/",
    "policy/CODEX_DELEGATION_POLICY.md",
    "docs/browser-github-and-parallel-workers.md"
  ],
  "bundledDependencies": [
    "@modelcontextprotocol/sdk",
    "express",
    "zod"
  ],
  "license": "MIT",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "concurrently -k \"npm:dev:server\" \"npm:dev:web\"",
    "dev:server": "tsx watch server/index.ts",
    "dev:web": "vite --host 127.0.0.1",
    "desktop": "npm run build && electron desktop/main.cjs",
    "desktop:smoke": "npm run build && node scripts/desktop-smoke.mjs",
    "desktop:interaction-smoke": "npm run build && node scripts/electron-annotation-smoke.mjs",
    "desktop:package": "npm run build && node scripts/prepare-mcp-helper-runtime.mjs && electron-builder --publish never && node scripts/desktop-smoke.mjs --packaged && node scripts/mcp-helper-package-smoke.mjs",
    "build": "node scripts/clean-build.mjs && tsc -p tsconfig.server.json && vite build",
    "start": "node bin/pseudoharness.js",
    "package": "npm run build && node scripts/package.mjs",
    "lint": "oxlint --deny-warnings --ignore-path .eslintignore src server tests scripts bin vite.config.ts",
    "test": "vitest run",
    "typecheck": "tsc --noEmit -p tsconfig.json && tsc --noEmit -p tsconfig.server.json"
  },
  "keywords": [],
  "author": "",
  "type": "module",
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.32.1",
    "express": "^5.3.0",
    "smol-toml": "^1.9.1",
    "zod": "^4.6.7"
  },
  "overrides": {
    "body-parser": "^2.4.0",
    "fast-uri": "^3.1.9"
  },
  "devDependencies": {
    "@codemirror/commands": "^6.11.1",
    "@codemirror/lang-markdown": "^6.5.2",
    "@codemirror/language": "^6.13.1",
    "@codemirror/state": "^6.7.6",
    "@codemirror/view": "^6.43.15",
    "@lezer/markdown": "^1.8.1",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.8",
    "@types/express": "^5.0.6",
    "@types/node": "^26.6.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "concurrently": "^10.0.6",
    "electron": "^45.0.0",
    "electron-builder": "^26.15.3",
    "jsdom": "^30.1.3",
    "lucide-react": "^1.59.0",
    "oxlint": "^1.76.0",
    "pe-library": "^0.4.1",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-markdown": "^10.1.0",
    "remark-gfm": "^4.0.1",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vite": "^8.3.4",
    "vitest": "^5.0.5"
  },
  "bundleDependencies": [
    "@modelcontextprotocol/sdk",
    "express",
    "zod"
  ]
}
